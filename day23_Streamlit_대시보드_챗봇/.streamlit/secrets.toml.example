# 이 파일을 secrets.toml 로 복사해 본인 키를 채우세요 (발급: https://platform.openai.com/api-keys).
# secrets.toml 은 .gitignore 에 있어 저장소에 올라가지 않습니다.
#
# ⚠️ 값에 큰따옴표 필수. .env 가 아니라 TOML 입니다.
#      OPENAI_API_KEY = "sk-..."    O
#      OPENAI_API_KEY = sk-...      X  파일이 파싱되지 않아 앱이 멈춥니다
#
# 배포할 때도 같은 형식으로 Advanced settings → Secrets 칸에 붙여 넣습니다.
OPENAI_API_KEY = "sk-여기에-본인-키"
